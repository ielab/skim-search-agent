# SkimSearchAgent environment template.
# Copy to .env, fill in what you need, then load it into your shell:
#
#     cp .env.example .env
#     set -a; source .env; set +a
#
# Nothing auto-loads this file — it is plain shell, kept dependency-free on purpose.
# Never commit a filled-in .env.

# --- API keys (only needed for the provider you actually use) --------------------
# OpenAI models (--model gpt-*) and the default LLM judge:
OPENAI_API_KEY=
# Gemini models through Gemini's OpenAI-compatible endpoint (--model gemini-*):
GEMINI_API_KEY=
# A locally served OpenAI-compatible model (--backend api) needs NO key;
# point --api-base (or VLLM_API_BASE) at the server, e.g. http://localhost:8000/v1

# --- Java (Pyserini/Lucene backends only) ----------------------------------------
# Pyserini 1.2 / Lucene needs JDK 21+. With a conda-installed openjdk:
# JAVA_HOME=$CONDA_PREFIX/lib/jvm

# --- Retrieval backends ----------------------------------------------------------
# BM25: "local" (dependency-free, default) or "pyserini" (Lucene, paper setting)
# BM25_BACKEND=pyserini
# BQL/structured executor: "python" (reference, default) or "lucene" (paper setting)
# STRUCTURED_BACKEND=lucene
# Dense encoder (paper default):
# DENSE_MODEL=BAAI/bge-base-en-v1.5

# --- Paper base-configuration guard (docs/SIEVE.md, docs/ITER.md) ----------------
# Every length budget is in TOKENS (see docs/CONFIGURATION.md); there are no character caps.
# MAX_VISIT_TOKENS=12000
# MAX_SECTION_TOKENS=12000
# (the step cap is a run_eval FLAG, not an env var: --max-steps 100 / max_steps=100)
# BQL_SOFT_FALLBACK=1        # 0 = strict-Boolean ablation

# --- Agent driver ----------------------------------------------------------------
# Hosted/OpenAI-compatible models default to the OpenAI Agents SDK when
# `openai-agents` is installed, else the built-in loop driver. Force with:
# AGENT_DRIVER=loop          # or: sdk

# --- LLM judge (BrowseComp-Plus scoring) -----------------------------------------
# LLM_JUDGE_MODEL=gpt-4o-mini
